# Copy to .env and adjust as needed. Every variable below has a sensible
# default (shown as a comment) if you don't set it -- .env is optional for
# local development, not required.

# --- Solana / Backstop program ---

# Devnet RPC endpoint used by the backend and by scripts/day2-real-mint.ts,
# scripts/refresh-snapshot.ts, scripts/rotate-attestor.ts, scripts/reconcile.ts.
# Default: https://api.devnet.solana.com
# SOLANA_RPC_URL=

# Path to the Solana CLI keypair used to sign transactions from scripts
# (must be BACKSTOP_ADMIN's keypair for devnet:mint / rotate:attestor).
# Default: ~/.config/solana/id.json
# SOLANA_KEYPAIR_PATH=

# Overrides the TSLA devnet regression mint scripts/refresh-snapshot.ts
# and scripts/reconcile.ts operate on by default, and the mint the
# backend's GET /assets lists as the devnet demo asset.
# Default: AznKjEBysg2hQXABxfquXNTTwavMz7mFMaBjYSUUX5fR
# BACKSTOP_DEMO_MINT=

# --- PreStocks integration (backend/integrations/prestocks.ts) ---

# PreStocks' own token catalogue API (identity, mark price, supply).
# Default: https://prestocks.com/api/prestocks
# PRESTOCKS_CATALOG_URL=

# Solana mainnet-beta RPC endpoint used to confirm PreStocks mint identity
# (Token-2022 metadata) and to read live mainnet supply.
# Default: https://api.mainnet-beta.solana.com
# PRESTOCKS_RPC_URL=

# Timeout for the PreStocks catalogue fetch, in milliseconds.
# Default: 8000
# PRESTOCKS_FETCH_TIMEOUT_MS=

# How long a successful catalogue fetch is cached in-memory, in
# milliseconds, before the next request triggers a fresh fetch.
# Default: 15000
# PRESTOCKS_CATALOG_CACHE_MS=

# --- Pyth integration (backend/integrations/pyth.ts) ---

# Hermes endpoint. Default: https://pyth.dourolabs.app/hermes
# PYTH_HERMES_URL=

# As of the August 26, 2026 Pyth Core upgrade, Hermes requires an API key
# for sustained use. Without one, Pyth evidence will come back UNAVAILABLE
# (reason: unauthorized_missing_or_invalid_api_key) even for TSLA, which
# does have a configured feed.
# PYTH_API_KEY=

# Maximum acceptable age of a Pyth price, in seconds, before it's
# considered stale. Default: 300
# PYTH_MAX_AGE_SECONDS=

# Maximum acceptable Pyth confidence interval, in basis points of price,
# before a price is considered too uncertain to use. Default: 100 (1%)
# PYTH_MAX_CONFIDENCE_BPS=

# Timeout for the Hermes price-update request, in milliseconds.
# Default: 8000
# PYTH_FETCH_TIMEOUT_MS=

# --- Backend API server ---

# Port the backend HTTP server listens on. Default: 8787
# PORT=

# --- mock-consumer (mock-consumer/index.ts) ---

# Base URL of the Backstop API the mock consumer checks against.
# Default: http://localhost:8787
# BACKSTOP_API_URL=

# Comma-separated mint addresses the mock consumer evaluates.
# Default: the TSLA devnet mint + the PreStocks ANTHROPIC mainnet mint
# BACKSTOP_CONSUMER_MINTS=
